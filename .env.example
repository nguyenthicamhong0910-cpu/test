# Copy to .env only for local testing. Never commit real secrets.
# Generate a random secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ccb_tay_ninh
COOKIE_SECURE=false
ALLOW_LOCAL_DEV=true
